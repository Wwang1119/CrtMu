# Backend port. Change this only if 3000 is already occupied.
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=

# Provider mode:
# - mock: no real model call, best for learning and local testing
# - ark: call Doubao/Ark runtime for real replies
AI_PROVIDER=mock

# Ark runtime configuration.
# Official runtime base URL currently uses:
# https://ark.cn-beijing.volces.com/api/v3
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
# Usually this should be your Ark Endpoint ID, for example: ep-2025xxxx
ARK_MODEL=
ARK_TEXT_MODEL=
ARK_VISION_MODEL=
ARK_IMAGE_MODEL=
ARK_IMAGE_SIZE=1024x1024
ARK_IMAGE_WATERMARK=true
ARK_TIMEOUT_MS=60000

# Backward-compatible aliases if you still prefer the older naming.
DOUBAO_API_KEY=
DOUBAO_MODEL=
