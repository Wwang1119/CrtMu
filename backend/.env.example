# Backend port. Change this only if 3000 is already occupied.
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=

# Data store:
# - json: local backend/data/app-db.json, best for local development
# - mysql: CloudBase SQL / MySQL 8.0
# - cloudbase: CloudBase document database, cheap CloudBase-native option
DATA_STORE=json

# Required when DATA_STORE=cloudbase outside CloudBase auto-detection.
CLOUDBASE_ENV_ID=yudu-web-8g1ccrez1a12fa8d
CLOUDBASE_TIMEOUT_MS=15000
# Optional but recommended for backend SDK calls when CloudBase Run does not
# provide a service role automatically. Do not commit real secret values.
CLOUDBASE_SECRETID=
CLOUDBASE_SECRETKEY=

# Temporary runtime diagnostics. This only exposes booleans and config names,
# never secret values. Keep false unless actively debugging a deployment.
ENABLE_RUNTIME_DEBUG=false

# MySQL configuration. Fill DB_PASSWORD only in your local .env or CloudBase
# environment variables. Do not commit real database passwords.
DB_HOST=172.17.0.10
DB_PORT=3306
DB_NAME=yudu-web-8g1ccrez1a12fa8d
DB_USER=crtmu_admin
DB_PASSWORD=

# Provider mode:
# - mock: no real model call, best for learning and local testing
# - ark: call Doubao/Ark runtime for real replies
AI_PROVIDER=mock

# Ark runtime configuration.
# Official runtime base URL currently uses:
# https://ark.cn-beijing.volces.com/api/v3
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
# Usually this should be your Ark Endpoint ID, for example: ep-2025xxxx
ARK_MODEL=
ARK_TEXT_MODEL=
ARK_VISION_MODEL=
ARK_IMAGE_MODEL=
ARK_IMAGE_SIZE=1024x1024
ARK_IMAGE_WATERMARK=true
ARK_TIMEOUT_MS=60000

# Backward-compatible aliases if you still prefer the older naming.
DOUBAO_API_KEY=
DOUBAO_MODEL=
